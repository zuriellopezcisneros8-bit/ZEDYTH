+def _pct(v):
+    """Porcentaje legible: 0 → «0%», 0.04 → «<0.1%», 0.3 → «0.3%», 22.4 → «22%». Evita que un uso pequeño pero real se vea como 0%."""
+    if v is None:
+        return "—"
+    if v <= 0:
+        return "0%"
+    if v < 0.1:
+        return "<0.1%"
+    if v < 10:
+        return f"{v:.1f}%"
+    return f"{v:.0f}%"
+
+
